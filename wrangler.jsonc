{
  "name": "notes-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The page is bundled into the Worker as text, so no separate asset upload is needed.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notes-studio",
      "database_id": "815f7d38-bfdb-446e-bb17-8e4453522b9a"
    }
  ]
}
